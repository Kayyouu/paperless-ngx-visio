"""Parser for Microsoft Visio files (.vsdx, .vsd, etc.)"""

from pathlib import Path
from typing import Optional

from django.conf import settings
from gotenberg_client import GotenbergClient
from gotenberg_client.options import PdfAFormat
from PIL import Image, ImageDraw, ImageFont

from documents.parsers import DocumentParser, ParseError
from documents.parsers import make_thumbnail_from_pdf
from paperless.models import OutputTypeChoices


class VisioDocumentParser(DocumentParser):
    """Parser for Microsoft Visio files with native VSDX extraction and PDF conversion."""

    logging_name = "paperless.parsing.visio"

    def get_settings(self):
        return None

    def parse(self, document_path: Path, mime_type: str, file_name: str = None):
        """Extract text from VSDX and generate PDF archive."""
        try:
            document_path = Path(document_path)
            if document_path.suffix.lower() == ".vsdx":
                self._parse_vsdx_native(document_path)
            else:
                self.text = ""
            self.archive_path = self._convert_to_pdf(document_path)
        except Exception as e:
            raise ParseError(f"Could not parse Visio file {document_path.name}: {str(e)}")

    def get_thumbnail(self, document_path: Path, mime_type: str, file_name: str = None) -> Path:
        """Generate thumbnail from PDF or placeholder."""
        try:
            if not self.archive_path:
                self.archive_path = self._convert_to_pdf(document_path)
            if self.archive_path:
                return make_thumbnail_from_pdf(
                    self.archive_path, self.tempdir, self.logging_group
                )
        except Exception as e:
            self.log.debug(f"Thumbnail from PDF failed: {e}")
        return self._create_placeholder_thumbnail(file_name)

    def _parse_vsdx_native(self, document_path: Path):
        """Extract text from VSDX using vsdx library."""
        try:
            import vsdx
        except ImportError:
            raise ImportError("vsdx library not installed. Install with: pip install vsdx")

        with vsdx.VisioFile(str(document_path)) as visio_file:
            text_parts = []
            for page in visio_file.pages:
                for shape in page.shapes:
                    if shape.text:
                        text_parts.append(shape.text.strip())
                    if hasattr(shape, "data") and shape.data:
                        text_parts.extend(f"{k}: {v}" for k, v in shape.data.items() if v)
            self.text = "\n".join(filter(None, text_parts))
            if self.text:
                self.log.info(f"Extracted {len(self.text)} characters from {document_path.name}")

    def _convert_to_pdf(self, document_path: Path) -> Optional[Path]:
        """Convert Visio file to PDF using Gotenberg."""
        try:
            pdf_path = Path(self.tempdir) / f"{Path(document_path).stem}.pdf"

            with (
                GotenbergClient(
                    host=settings.TIKA_GOTENBERG_ENDPOINT,
                    timeout=settings.CELERY_TASK_TIME_LIMIT,
                ) as client,
                client.libre_office.to_pdf() as route,
            ):
                if settings.OCR_OUTPUT_TYPE in {
                    OutputTypeChoices.PDF_A,
                    OutputTypeChoices.PDF_A2,
                }:
                    route.pdf_format(PdfAFormat.A2b)
                elif settings.OCR_OUTPUT_TYPE == OutputTypeChoices.PDF_A1:
                    route.pdf_format(PdfAFormat.A2b)
                elif settings.OCR_OUTPUT_TYPE == OutputTypeChoices.PDF_A3:
                    route.pdf_format(PdfAFormat.A3b)
                route.convert(document_path)
                pdf_path.write_bytes(route.run().content)
                return pdf_path
        except Exception as e:
            self.log.warning(f"PDF conversion failed: {e}")
            return None

    def _create_placeholder_thumbnail(self, file_name: Optional[str] = None) -> Path:
        """Create a placeholder thumbnail with Visio branding."""
        output_path = self.tempdir / "thumb.webp"
        try:
            img = Image.new("RGB", (500, 700), color="#4472C4")
            draw = ImageDraw.Draw(img)
            try:
                font = ImageFont.truetype(settings.THUMBNAIL_FONT_NAME, size=45)
            except (AttributeError, OSError):
                font = ImageFont.load_default()

            text_lines = ["Microsoft Visio", "Diagram"]
            if file_name:
                text_lines.append(f"\n{file_name}")

            y = 250
            for line in text_lines:
                bbox = draw.textbbox((0, 0), line, font=font)
                x = (500 - (bbox[2] - bbox[0])) // 2
                draw.text((x, y), line, font=font, fill="white")
                y += 80

            img.save(output_path, format="WEBP", quality=85)
            return output_path
        except Exception as e:
            self.log.warning(f"Placeholder thumbnail failed: {e}")
            try:
                Image.new("RGB", (500, 700), color="#4472C4").save(output_path, format="WEBP")
                return output_path
            except Exception:
                return None
